{
  "manifest_version": 3,
  "name": "Stacks — Tab Organizer",
  "version": "0.8.1",
  "description": "Keep tabs together in Chrome. Organize by website with real logos, or create custom stacks that stay out of automatic grouping.",
  "minimum_chrome_version": "127",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "contextMenus",
    "favicon"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Custom stacks · Right-click for website grouping",
    "default_popup": "manager.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'; img-src 'self' data:"
  }
}
